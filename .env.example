PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prorab_talk
GROQ_API_KEY=

# Optional Telegram worker in the same service (Node 24).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
BOT_MODE=polling
# Required absolute persistent-disk path when TELEGRAM_ENABLED=true.
DB_PATH=/var/data/agent-stroy.sqlite
# Only for BOT_MODE=webhook.
WEBHOOK_SECRET=
