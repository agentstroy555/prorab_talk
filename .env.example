PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prorab_talk
GROQ_API_KEY=
# Optional override of the owner-authorized embedded Telegram token.
# On Render the bot, PostgreSQL and webhook start automatically without a disk.
TELEGRAM_BOT_TOKEN=
# Local web-only mode (ignored on Render):
# TELEGRAM_ENABLED=false
# Local development only (Render always uses webhook + DATABASE_URL):
# BOT_MODE=polling
# DB_PATH=/absolute/path/to/agent-stroy.sqlite
# BOT_PUBLIC_URL=https://your-development-service.example
# WEBHOOK_SECRET=optional_override_of_automatic_secret
