# Set secrets later, outside source control. Never upload a real .env in a source ZIP.
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
# Numeric Telegram user IDs, comma separated. Empty list denies all access.
ALLOWED_USER_IDS=
# polling: worker/VPS; webhook: always-on HTTPS web service.
BOT_MODE=polling
WEBHOOK_SECRET=
PORT=3000
DB_PATH=./var/agent-stroy.sqlite
MAX_VOICE_SECONDS=120
MAX_VOICE_BYTES=15000000
MAX_PENDING_UPDATES=500
STT_REQUESTS_PER_MINUTE=15
STT_REQUESTS_PER_DAY=300
STT_AUDIO_SECONDS_PER_DAY=7200
