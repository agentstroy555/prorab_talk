# API credentials are supplied through environment variables.
# Any human user can start a private conversation; no user IDs to configure.
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
# polling: worker/VPS; webhook: always-on HTTPS web service.
BOT_MODE=polling
WEBHOOK_SECRET=
PORT=3000
DB_PATH=./var/agent-stroy.sqlite
MAX_VOICE_SECONDS=120
MAX_VOICE_BYTES=15000000
MAX_PENDING_UPDATES=500
STT_REQUESTS_PER_MINUTE=15
STT_REQUESTS_PER_DAY=300
STT_AUDIO_SECONDS_PER_DAY=7200
